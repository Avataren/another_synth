{
  "name": "@another-synth/tracker-playback",
  "version": "0.0.1",
  "description": "Standalone tracker replay core: parses MOD/XM/S3M and schedules them, leaving the sound to the host.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "tracker",
    "playback",
    "audio",
    "sequencer",
    "mod",
    "xm",
    "s3m",
    "protracker",
    "fasttracker",
    "scream-tracker",
    "amiga"
  ],
  "author": "Morten Andersson <morten.andersson@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  }
}
